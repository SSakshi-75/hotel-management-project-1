<%@ Master Language="C#" AutoEventWireup="true" CodeFile="MasterPage.master.cs" Inherits="MasterPage" %>

<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Hotel Management | Luxury Hotel & Resort System</title>
    <meta name="description" content="Welcome to Hotel Management, a luxury hotel & resort offering premier rooms, fine dining, spa, and world-class hospitality services.">
    <meta name="keywords" content="Hotel Management, Luxury Hotel, Hotel Booking, Resort, Rooms, Hotel Services, Suites">
    <meta name="author" content="Hotel Management">

    <!-- Bootstrap 5 CSS -->
    <link rel="stylesheet" type="text/css" href="css/bootstrap.min.css">
    
    <!-- Bootstrap Icons & Font Awesome CDN -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

    <!-- Vendor CSS & Swiper & AOS -->
    <link rel="stylesheet" type="text/css" href="css/vendor.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@9/swiper-bundle.min.css" />
    <link rel="stylesheet" href="https://unpkg.com/aos@2.3.1/dist/aos.css" />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Upright:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,400..900;1,400..900&family=Plus+Jakarta+Sans:ital,wght@0,300..800;1,300..800&display=swap" rel="stylesheet">

    <!-- Custom Main Stylesheet -->
    <link rel="stylesheet" type="text/css" href="style.css">

    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
</head>
<body>
    <form id="form1" runat="server">

        <!-- ==========================================
             TOP HEADER / INFO BAR
             ========================================== -->
        <div class="top-bar-info bg-dark text-white py-2 border-bottom border-secondary border-opacity-25">
            <div class="container-fluid px-4 px-lg-5">
                <div class="d-flex flex-wrap justify-content-between align-items-center">
                    
                    <!-- Contact Details -->
                    <div class="d-flex flex-wrap align-items-center gap-4">
                        <span class="d-inline-flex align-items-center">
                            <i class="bi bi-geo-alt-fill text-warning me-2"></i>
                            Chanakyapuri, New Delhi, India 110021
                        </span>
                        <span class="d-inline-flex align-items-center">
                            <i class="bi bi-telephone-fill text-warning me-2"></i>
                            <a href="tel:+911139331234" class="text-white text-decoration-none">+91 11 3933 1234</a>
                        </span>
                        <span class="d-inline-flex align-items-center d-none d-md-inline-flex">
                            <i class="bi bi-envelope-fill text-warning me-2"></i>
                            <a href="mailto:info@hotelmanagement.com" class="text-white text-decoration-none">info@hotelmanagement.com</a>
                        </span>
                    </div>

                    <!-- Social Links & Concierge Badge -->
                    <div class="d-flex align-items-center gap-3">
                        <div class="d-flex gap-2">
                            <a href="#" class="text-white hover-warning px-1" title="Facebook"><i class="bi bi-facebook"></i></a>
                            <a href="#" class="text-white hover-warning px-1" title="Instagram"><i class="bi bi-instagram"></i></a>
                            <a href="#" class="text-white hover-warning px-1" title="Twitter"><i class="bi bi-twitter-x"></i></a>
                            <a href="#" class="text-white hover-warning px-1" title="LinkedIn"><i class="bi bi-linkedin"></i></a>
                        </div>
                        <span class="text-secondary d-none d-sm-inline">|</span>
