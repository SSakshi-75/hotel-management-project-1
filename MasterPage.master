                            <li><a href="Services.aspx" class="text-decoration-none" style="color: #555555; font-size: 0.88rem;"><i class="bi bi-cup-hot-fill small me-2" style="color: #B88E68;"></i>Fine Dining Restaurant</a></li>
                            <li><a href="Services.aspx" class="text-decoration-none" style="color: #555555; font-size: 0.88rem;"><i class="bi bi-water small me-2" style="color: #B88E68;"></i>Heated Infinity Pool</a></li>
                            <li><a href="Services.aspx" class="text-decoration-none" style="color: #555555; font-size: 0.88rem;"><i class="bi bi-building small me-2" style="color: #B88E68;"></i>Conference &amp; Banquet</a></li>
                            <li><a href="Services.aspx" class="text-decoration-none" style="color: #555555; font-size: 0.88rem;"><i class="bi bi-car-front-fill small me-2" style="color: #B88E68;"></i>Airport Limo Transfer</a></li>
                        </ul>
                    </div>

