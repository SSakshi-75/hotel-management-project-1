                            <a href="#" style="width:38px;height:38px;border-radius:50%;border:1px solid #e8ddd3;display:flex;align-items:center;justify-content:center;color:#442305;font-size:0.9rem;transition:all 0.3s;" title="Facebook"><i class="bi bi-facebook"></i></a>
                            <a href="#" style="width:38px;height:38px;border-radius:50%;border:1px solid #e8ddd3;display:flex;align-items:center;justify-content:center;color:#442305;font-size:0.9rem;" title="Instagram"><i class="bi bi-instagram"></i></a>
                            <a href="#" style="width:38px;height:38px;border-radius:50%;border:1px solid #e8ddd3;display:flex;align-items:center;justify-content:center;color:#442305;font-size:0.9rem;" title="Twitter"><i class="bi bi-twitter-x"></i></a>
                            <a href="#" style="width:38px;height:38px;border-radius:50%;border:1px solid #e8ddd3;display:flex;align-items:center;justify-content:center;color:#442305;font-size:0.9rem;" title="LinkedIn"><i class="bi bi-linkedin"></i></a>
                            <a href="#" style="width:38px;height:38px;border-radius:50%;border:1px solid #e8ddd3;display:flex;align-items:center;justify-content:center;color:#442305;font-size:0.9rem;" title="YouTube"><i class="bi bi-youtube"></i></a>
                        </div>
