                            <li><a href="index.aspx" class="text-decoration-none" style="color: #555555; font-size: 0.88rem;"><i class="bi bi-chevron-right small me-1" style="color: #B88E68;"></i> Home</a></li>
                            <li><a href="About.aspx" class="text-decoration-none" style="color: #555555; font-size: 0.88rem;"><i class="bi bi-chevron-right small me-1" style="color: #B88E68;"></i> About Us</a></li>
                            <li><a href="Room.aspx" class="text-decoration-none" style="color: #555555; font-size: 0.88rem;"><i class="bi bi-chevron-right small me-1" style="color: #B88E68;"></i> Rooms &amp; Suites</a></li>
                            <li><a href="Services.aspx" class="text-decoration-none" style="color: #555555; font-size: 0.88rem;"><i class="bi bi-chevron-right small me-1" style="color: #B88E68;"></i> Amenities</a></li>
