                                    <i class="bi bi-geo-alt-fill"></i>
                                </div>
                                <div>
                                    <span style="color: #333333; font-size: 0.88rem; font-weight: 600; display: block;">Chanakyapuri, New Delhi</span>
                                    <small style="color: #999999; font-size: 0.75rem;">India 110021</small>
                                </div>
                            </div>
                            <div class="d-flex align-items-start gap-3">
                                <div style="width:36px;height:36px;min-width:36px;border-radius:8px;background:#fdf8f3;border:1px solid #e8ddd3;display:flex;align-items:center;justify-content:center;color:#B88E68;font-size:0.85rem;">
                                    <i class="bi bi-telephone-fill"></i>
                                </div>
                                <div>
                                    <a href="tel:+911139331234" class="text-decoration-none" style="color: #333333; font-size: 0.88rem; font-weight: 600; display: block;">+91 11 3933 1234</a>
                                    <small style="color: #999999; font-size: 0.75rem;">24/7 Available</small>
                                </div>
                            </div>
                            <div class="d-flex align-items-start gap-3">
                                <div style="width:36px;height:36px;min-width:36px;border-radius:8px;background:#fdf8f3;border:1px solid #e8ddd3;display:flex;align-items:center;justify-content:center;color:#B88E68;font-size:0.85rem;">
                                    <i class="bi bi-envelope-fill"></i>
                                </div>
                                <div>
                                    <a href="mailto:info@hotelmanagement.com" class="text-decoration-none" style="color: #333333; font-size: 0.85rem; font-weight: 600; display: block;">info@hotelmanagement.com</a>
                                    <small style="color: #999999; font-size: 0.75rem;">Reservation Desk</small>
                                </div>
                            </div>
                        </div>

                        <p style="color: #888888; font-size: 0.8rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.8px; margin-bottom: 8px;">Subscribe for Exclusive Offers</p>
                        <div class="input-group">
                            <input type="email" class="form-control" style="border: 1px solid #e8ddd3; background: #fdf8f3; font-size: 0.85rem;" placeholder="Your email address" aria-label="Email">
                            <button class="btn text-white px-3" style="background: #442305; border: 1px solid #442305;" type="button"><i class="bi bi-arrow-right"></i></button>
                        </div>
                    </div>

                </div>

                <!-- Footer Bottom Bar -->
                <div class="py-3 d-flex flex-wrap justify-content-between align-items-center small" style="color: #999999;">
                    <p class="mb-0">&copy; 2026 <strong style="color: #442305;">Hotel Management</strong>. All Rights Reserved.</p>
                    <div class="d-flex align-items-center gap-3 mt-2 mt-sm-0">
                        <a href="Privacy.aspx" class="text-decoration-none" style="color: #999999;">Privacy Policy</a>
                        <span style="width:4px;height:4px;border-radius:50%;background:#B88E68;display:inline-block;"></span>
                        <a href="Terms.aspx" class="text-decoration-none" style="color: #999999;">Terms &amp; Conditions</a>
                        <span style="width:4px;height:4px;border-radius:50%;background:#B88E68;display:inline-block;"></span>
                        <a href="Contact.aspx" class="text-decoration-none" style="color: #999999;">Sitemap</a>
                    </div>
