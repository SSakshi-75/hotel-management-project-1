                            <img src="images/logo.png" alt="Hotel Management Logo" style="height: 50px; width: auto;" onerror="this.onerror=null; this.src='images/main-logo.png';">
                            <button type="button" class="btn-close shadow-none" data-bs-dismiss="offcanvas" aria-label="Close"></button>
                        </div>

                        <div class="offcanvas-body align-items-center">
                            <ul class="navbar-nav mx-auto mb-2 mb-lg-0 gap-lg-4 text-uppercase fw-semibold letter-spacing-1 fs-6">
                                <li class="nav-item">
                                    <a class="nav-link" href="index.aspx">Home</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" href="About.aspx">About Us</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" href="Room.aspx">Rooms</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" href="Services.aspx">Amenities</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" href="Contact.aspx">Contact Us</a>
                                </li>
                            </ul>

                            <div class="d-flex align-items-center gap-3">
                                <a href="Booking.aspx" class="btn btn-navbar-theme px-4 py-2 rounded-pill fw-bold text-uppercase shadow-sm">
                                    <i class="bi bi-calendar-check me-2"></i> Book Now
                                </a>
                            </div>
                        </div>

                    </div>

                </div>
            </nav>
        </header>

        <!-- ==========================================
             MAIN CONTENT PLACEHOLDER
             ========================================== -->
        <main>
            <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server">
            </asp:ContentPlaceHolder>
        </main>

        <!-- ==========================================
             PROFESSIONAL LUXURY FOOTER
             ========================================== -->
        <footer id="footer" style="background: #ffffff; border-top: 3px solid #B88E68; margin-top: 0;">
            <div class="container-fluid px-4 px-lg-5">
                <div class="row g-4 py-5" style="border-bottom: 1px solid #e8ddd3;">
                    
                    <!-- Column 1: Logo & Brand -->
                    <div class="col-lg-4 col-md-6">
