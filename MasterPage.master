                    <!-- Column 1: Brand Info -->
                    <div class="col-lg-4 col-md-6">
                        <div class="footer-brand mb-3">
                            <a href="index.aspx">
                                <img src="images/logo.png" alt="Hotel Management Logo" style="height: 85px; width: auto; object-fit: contain; mix-blend-mode: multiply;" onerror="this.onerror=null; this.src='images/main-logo.png';">
                            </a>
                        </div>
                        <p class="pe-lg-4 text-muted" style="line-height: 1.7;">
                            Hotel Management is a benchmark of luxury, tranquility, and world-class Indian hospitality. Experience handcrafted suites, opulent fine dining, and serene spa facilities.
                        </p>
                        <div class="d-flex gap-3 mt-4">
                            <a href="#" class="btn btn-navbar-theme rounded-circle d-inline-flex align-items-center justify-content-center shadow-sm" style="width: 40px; height: 40px; padding: 0;" title="Facebook"><i class="bi bi-facebook fs-5"></i></a>
                            <a href="#" class="btn btn-navbar-theme rounded-circle d-inline-flex align-items-center justify-content-center shadow-sm" style="width: 40px; height: 40px; padding: 0;" title="Instagram"><i class="bi bi-instagram fs-5"></i></a>
                            <a href="#" class="btn btn-navbar-theme rounded-circle d-inline-flex align-items-center justify-content-center shadow-sm" style="width: 40px; height: 40px; padding: 0;" title="Twitter"><i class="bi bi-twitter-x fs-5"></i></a>
                            <a href="#" class="btn btn-navbar-theme rounded-circle d-inline-flex align-items-center justify-content-center shadow-sm" style="width: 40px; height: 40px; padding: 0;" title="YouTube"><i class="bi bi-youtube fs-5"></i></a>
                        </div>
                    </div>

                    <!-- Column 2: Quick Links -->
                    <div class="col-lg-2 col-md-6">
                        <h4 class="mb-3" style="color: #442305;">Quick Links</h4>
                        <ul class="list-unstyled d-flex flex-column gap-2 mb-0">
                            <li><a href="index.aspx" class="text-decoration-none text-muted"><i class="bi bi-chevron-right small me-1" style="color: #B88E68;"></i> Home</a></li>
                            <li><a href="About.aspx" class="text-decoration-none text-muted"><i class="bi bi-chevron-right small me-1" style="color: #B88E68;"></i> About Us</a></li>
                            <li><a href="Room.aspx" class="text-decoration-none text-muted"><i class="bi bi-chevron-right small me-1" style="color: #B88E68;"></i> Rooms &amp; Suites</a></li>
                            <li><a href="Services.aspx" class="text-decoration-none text-muted"><i class="bi bi-chevron-right small me-1" style="color: #B88E68;"></i> Our Amenities</a></li>
                            <li><a href="Contact.aspx" class="text-decoration-none text-muted"><i class="bi bi-chevron-right small me-1" style="color: #B88E68;"></i> Contact Us</a></li>
                        </ul>
                    </div>

                    <!-- Column 3: Hotel Services -->
                    <div class="col-lg-3 col-md-6">
                        <h4 class="mb-3" style="color: #442305;">Our Services</h4>
                        <ul class="list-unstyled d-flex flex-column gap-2 mb-0">
                            <li><a href="Services.aspx" class="text-decoration-none text-muted"><i class="bi bi-chevron-right small me-1" style="color: #B88E68;"></i> Luxury Spa &amp; Wellness</a></li>
                            <li><a href="Services.aspx" class="text-decoration-none text-muted"><i class="bi bi-chevron-right small me-1" style="color: #B88E68;"></i> Fine Dining Restaurant</a></li>
                            <li><a href="Services.aspx" class="text-decoration-none text-muted"><i class="bi bi-chevron-right small me-1" style="color: #B88E68;"></i> Heated Swimming Pool</a></li>
                            <li><a href="Services.aspx" class="text-decoration-none text-muted"><i class="bi bi-chevron-right small me-1" style="color: #B88E68;"></i> Conference &amp; Banquet Hall</a></li>
                            <li><a href="Services.aspx" class="text-decoration-none text-muted"><i class="bi bi-chevron-right small me-1" style="color: #B88E68;"></i> 24/7 Airport Transfer</a></li>
                        </ul>
                    </div>

                    <!-- Column 4: Newsletter & Contact -->
                    <div class="col-lg-3 col-md-6">
                        <h4 class="mb-3" style="color: #442305;">Stay Connected</h4>
                        <p class="small text-muted mb-3">Subscribe for exclusive offers, seasonal deals, and luxury packages.</p>
                        
                        <div class="input-group mb-3">
                            <input type="email" class="form-control border" placeholder="Enter your email" aria-label="Subscriber Email">
                            <button class="btn fw-bold px-3 text-white" style="background-color: #442305;" type="button"><i class="bi bi-send-fill"></i></button>
                        </div>

                        <div class="small text-muted">
                            <p class="mb-1"><i class="bi bi-geo-alt me-2" style="color: #442305;"></i> Chanakyapuri, New Delhi 110021</p>
                            <p class="mb-0"><i class="bi bi-telephone me-2" style="color: #442305;"></i> +91 11 3933 1234</p>
                        </div>
                    </div>

                </div>

                <!-- Footer Bottom -->
                <div class="py-3 d-flex flex-wrap justify-content-between align-items-center small text-muted border-top">
                    <p class="mb-0">&copy; 2026 Hotel Management. All Rights Reserved. Built with ASP.NET Web Forms &amp; Bootstrap 5.</p>
                    <div class="d-flex gap-3 mt-2 mt-sm-0">
                        <a href="Privacy.aspx" class="text-decoration-none text-muted">Privacy Policy</a>
                        <span>|</span>
                        <a href="Terms.aspx" class="text-decoration-none text-muted">Terms &amp; Conditions</a>
                    </div>
                </div>
            </div>
        </footer>

        <!-- Floating Back To Top Button -->
        <div id="backToTop" class="back-to-top" title="Back to top">
            <i class="bi bi-arrow-up-short fs-3"></i>
        </div>

    </form>

    <!-- JavaScript Files -->
    <script src="js/jquery-1.11.0.min.js"></script>
    <script src="js/bootstrap.bundle.min.js"></script>
    <script src="js/plugins.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/swiper@9/swiper-bundle.min.js"></script>
    <script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
    <script src="https://code.iconify.design/iconify-icon/1.0.7/iconify-icon.min.js"></script>
    <script src="js/script.js"></script>
    <script src="js/room.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            var currentPath = window.location.pathname.split("/").pop().toLowerCase();
            if (!currentPath || currentPath === "" || currentPath === "/") {
                currentPath = "index.aspx";
            }
            var navLinks = document.querySelectorAll(".navbar-nav .nav-link");
            navLinks.forEach(function (link) {
                link.classList.remove("active");
                var href = link.getAttribute("href");
                if (href) {
                    var linkPath = href.split("/").pop().toLowerCase();
                    if (linkPath === currentPath) {
                        link.classList.add("active");
                    }
                }
            });
        });
    </script>
</body>
</html>
