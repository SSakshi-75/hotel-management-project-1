                            <a href="javascript:void(0)" class="nav-link submenu-toggle" onclick="toggleSubmenu(this, event); return false;">
                                <span class="nav-icon"><i class="bi bi-cup-hot-fill"></i></span>
                                <span class="nav-text">Dining</span>
                                <i class="bi bi-chevron-right submenu-arrow"></i>
                            </a>
                            <ul class="sidebar-submenu">
                                <li class="submenu-item"><a href="javascript:void(0)" class="submenu-link" onclick="handleMenuClick('Restaurants', this)"><i class="bi bi-shop sub-icon"></i>Restaurants</a></li>
                                <li class="submenu-item"><a href="javascript:void(0)" class="submenu-link" onclick="handleMenuClick('Menu Management', this)"><i class="bi bi-book sub-icon"></i>Menu</a></li>
                            </ul>
                        </li>

                        <!-- Customers Accordion -->
                        <li class="nav-item has-submenu">
                            <a href="javascript:void(0)" class="nav-link submenu-toggle" onclick="toggleSubmenu(this, event); return false;">
                                <span class="nav-icon"><i class="bi bi-people-fill"></i></span>
                                <span class="nav-text">Customers</span>
                                <i class="bi bi-chevron-right submenu-arrow"></i>
                            </a>
                            <ul class="sidebar-submenu">
                                <li class="submenu-item"><a href="Users.aspx" class="submenu-link"><i class="bi bi-person-check sub-icon"></i>Registered Users</a></li>
                            </ul>
                        </li>

                        <!-- Reviews Accordion -->
                        <li class="nav-item has-submenu">
                            <a href="javascript:void(0)" class="nav-link submenu-toggle" onclick="toggleSubmenu(this, event); return false;">
                                <span class="nav-icon"><i class="bi bi-star-fill"></i></span>
                                <span class="nav-text">Reviews</span>
                                <i class="bi bi-chevron-right submenu-arrow"></i>
                            </a>
                            <ul class="sidebar-submenu">
                                <li class="submenu-item"><a href="Reviews.aspx" class="submenu-link"><i class="bi bi-chat-left-quote sub-icon"></i>Guest Reviews</a></li>
                            </ul>
                        </li>

                        <!-- Enquiries Accordion -->
                        <li class="nav-item has-submenu">
                            <a href="javascript:void(0)" class="nav-link submenu-toggle" onclick="toggleSubmenu(this, event); return false;">
                                <span class="nav-icon"><i class="bi bi-envelope-fill"></i></span>
                                <span class="nav-text">Enquiries</span>
                                <i class="bi bi-chevron-right submenu-arrow"></i>
                            </a>
