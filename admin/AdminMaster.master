                                <span class="nav-text">Hotel Management</span>
                                <i class="bi bi-chevron-right submenu-arrow"></i>
                            </a>
                            <ul class="sidebar-submenu">
                                <li class="submenu-item"><a href="ManageHotel.aspx" class="submenu-link"><i class="bi bi-buildings sub-icon"></i>Manage Hotel</a></li>
                                <li class="submenu-item"><a href="AddRoom.aspx" class="submenu-link"><i class="bi bi-plus-circle sub-icon"></i>Add Room</a></li>
                                <li class="submenu-item"><a href="Gallery.aspx" class="submenu-link"><i class="bi bi-images sub-icon"></i>Photo Gallery</a></li>
                            </ul>
                        </li>

                        <!-- Reservations Accordion -->
                        <li class="nav-item has-submenu">
                            <a href="javascript:void(0)" class="nav-link submenu-toggle" onclick="toggleSubmenu(this, event); return false;">
                                <span class="nav-icon"><i class="bi bi-calendar-check-fill"></i></span>
                                <span class="nav-text">Reservations</span>
                                <i class="bi bi-chevron-right submenu-arrow"></i>
                            </a>
                            <ul class="sidebar-submenu">
                                <li class="submenu-item"><a href="Bookings.aspx" class="submenu-link"><i class="bi bi-journal-bookmark sub-icon"></i>All Bookings</a></li>
                                <li class="submenu-item"><a href="javascript:void(0)" class="submenu-link" onclick="handleMenuClick('New Booking', this)"><i class="bi bi-calendar-plus sub-icon"></i>New Booking</a></li>
                                <li class="submenu-item"><a href="javascript:void(0)" class="submenu-link" onclick="handleMenuClick('Check-in / Check-out', this)"><i class="bi bi-arrow-left-right sub-icon"></i>Check-in / Out</a></li>
                            </ul>
                        </li>

                        <!-- Rates & Availability Accordion -->
                        <li class="nav-item has-submenu">
                            <a href="javascript:void(0)" class="nav-link submenu-toggle" onclick="toggleSubmenu(this, event); return false;">
                                <span class="nav-icon"><i class="bi bi-currency-rupee"></i></span>
                                <span class="nav-text">Rates & Availability</span>
                                <i class="bi bi-chevron-right submenu-arrow"></i>
                            </a>
                            <ul class="sidebar-submenu">
                                <li class="submenu-item"><a href="RoomRates.aspx" class="submenu-link"><i class="bi bi-tag sub-icon"></i>Room Rates</a></li>
                                <li class="submenu-item"><a href="Availability.aspx" class="submenu-link"><i class="bi bi-calendar3 sub-icon"></i>Availability</a></li>
                            </ul>
                        </li>

                        <!-- Offers & Packages Accordion -->
                        <li class="nav-item has-submenu">
                            <a href="javascript:void(0)" class="nav-link submenu-toggle" onclick="toggleSubmenu(this, event); return false;">
                                <span class="nav-icon"><i class="bi bi-gift-fill"></i></span>
                                <span class="nav-text">Offers & Packages</span>
                                <i class="bi bi-chevron-right submenu-arrow"></i>
                            </a>
                            <ul class="sidebar-submenu">
                                <li class="submenu-item"><a href="Offers.aspx" class="submenu-link"><i class="bi bi-percent sub-icon"></i>Offers</a></li>
                                <li class="submenu-item"><a href="Packages.aspx" class="submenu-link"><i class="bi bi-box-seam sub-icon"></i>Packages</a></li>
